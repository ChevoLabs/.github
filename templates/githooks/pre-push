#!/bin/sh
# Blocks direct pushes to main. GitHub Free has no branch protection for private repositories,
# so this local hook is the guard. Enable per clone:  git config core.hooksPath .githooks
# Emergency bypass (avoid):  git push --no-verify
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "✋ Direct push to main is blocked. Push a branch and open a pull request." >&2
    exit 1
  fi
done
exit 0
